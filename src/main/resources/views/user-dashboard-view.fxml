<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.company.system.controller.UserDashboardController"
            fitToWidth="true"
            pannable="true"
            hbarPolicy="AS_NEEDED"
            vbarPolicy="AS_NEEDED"
            styleClass="module-scroll">
    <content>
        <VBox spacing="18" styleClass="profile-page">
            <padding>
                <Insets top="28" right="28" bottom="28" left="28"/>
            </padding>

            <VBox spacing="4">
                <Label fx:id="titleLabel" text="Dashboard" styleClass="page-title"/>
                <Label fx:id="subtitleLabel"
                       text="Personal overview of your work, contract and department."
                       wrapText="true"
                       styleClass="page-subtitle"/>
            </VBox>

            <HBox spacing="18" maxWidth="900">
                <VBox fx:id="employeeCard" spacing="8" prefWidth="430" maxWidth="Infinity" styleClass="profile-card">
                    <Label fx:id="employeeTitleLabel" text="Personal details" styleClass="section-title"/>
                    <VBox fx:id="employeeDetailsBox" spacing="6"/>
                </VBox>

                <VBox fx:id="contractCard" spacing="8" prefWidth="430" maxWidth="Infinity" styleClass="profile-card">
                    <Label fx:id="contractTitleLabel" text="Contract information" styleClass="section-title"/>
                    <VBox fx:id="contractDetailsBox" spacing="6"/>
                </VBox>
            </HBox>

            <VBox fx:id="departmentCard" spacing="8" maxWidth="900" styleClass="profile-card">
                <Label fx:id="departmentTitleLabel" text="Department information" styleClass="section-title"/>
                <VBox fx:id="departmentDetailsBox" spacing="8"/>
                <Label fx:id="colleaguesTitleLabel" text="Colleagues" styleClass="section-title"/>
                <TableView fx:id="colleaguesTable" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="colleagueNameColumn" text="Name"/>
                        <TableColumn fx:id="colleaguePositionColumn" text="Position"/>
                        <TableColumn fx:id="colleagueEmailColumn" text="Email"/>
                        <TableColumn fx:id="colleagueStatusColumn" text="Status"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
