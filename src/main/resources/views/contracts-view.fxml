<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.company.system.controller.ContractsController"
            fitToWidth="true"
            pannable="true"
            style="-fx-background-color: #f8fafc; -fx-background: #f8fafc;">

    <content>
        <VBox spacing="18" style="-fx-padding: 24; -fx-background-color: #f8fafc;">

            <VBox spacing="4">
                <Label text="Kontratat"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                <Label text="Menaxhoni kontratat dhe lidhjen e tyre me punetoret."
                       style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
            </VBox>

            <HBox spacing="12"
                  style="-fx-background-color: white; -fx-padding: 14; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8;">
                <TextField fx:id="searchField"
                           promptText="Kerko sipas punetorit, llojit te kontrates ose statusit"
                           prefWidth="430"/>
            </HBox>

            <TableView fx:id="contractsTable"
                       prefHeight="300"
                       style="-fx-background-color: white; -fx-border-color: #d9e2ec; -fx-border-radius: 8;">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="55"/>
                    <TableColumn fx:id="employeeIdColumn" text="Employee ID" prefWidth="95"/>
                    <TableColumn fx:id="employeeNameColumn" text="Punetori" prefWidth="170"/>
                    <TableColumn fx:id="contractTypeColumn" text="Lloji" prefWidth="130"/>
                    <TableColumn fx:id="startDateColumn" text="Fillimi" prefWidth="105"/>
                    <TableColumn fx:id="endDateColumn" text="Mbarimi" prefWidth="105"/>
                    <TableColumn fx:id="salaryColumn" text="Paga" prefWidth="90"/>
                    <TableColumn fx:id="statusColumn" text="Statusi" prefWidth="100"/>
                </columns>
            </TableView>

            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8;">

                <Label text="Forma e kontrates"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                <GridPane hgap="12" vgap="12">
                    <TextField fx:id="employeeIdField"
                               promptText="Employee ID"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"/>

                    <TextField fx:id="contractTypeField"
                               promptText="Lloji i kontrates"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                    <TextField fx:id="salaryField"
                               promptText="Paga"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="2"/>

                    <DatePicker fx:id="startDatePicker"
                                promptText="Data e fillimit"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="0"/>

                    <DatePicker fx:id="endDatePicker"
                                promptText="Data e mbarimit"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="1"/>

                    <TextField fx:id="statusField"
                               promptText="Statusi"
                               text="Active"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="2"/>
                </GridPane>

                <HBox spacing="10">
                    <Button text="Shto"
                            onAction="#addContract"
                            style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <Button text="Perditeso"
                            onAction="#updateContract"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <Button text="Fshi"
                            onAction="#deleteContract"
                            style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <Button text="Pastro"
                            onAction="#clearForm"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>