<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<BorderPane fx:id="mainShell"
            styleClass="main-shell"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.company.system.controller.UserMainController">

    <stylesheets>
        <URL value="@../styles/app-theme.css"/>
    </stylesheets>

    <top>
        <HBox fx:id="topBar" styleClass="top-bar" alignment="CENTER_LEFT" spacing="14">
            <padding>
                <Insets top="0" right="18" bottom="0" left="12"/>
            </padding>

            <Button fx:id="menuToggleButton"
                    text="☰"
                    styleClass="icon-button"
                    onAction="#toggleSidebar"/>

            <Label fx:id="appTitleLabel"
                   text="Contract Manager"
                   styleClass="app-title"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label fx:id="loggedInLabel"
                   text="Logged in as: -"
                   styleClass="logged-in-label"/>
        </HBox>
    </top>

    <left>
        <VBox fx:id="sidebar"
              styleClass="sidebar"
              alignment="CENTER"
              spacing="10"
              prefWidth="220"
              minWidth="220">

            <VBox styleClass="nav-list" alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
                <Button fx:id="dashboardButton"
                        styleClass="nav-button"
                        maxWidth="Infinity"
                        onAction="#showDashboard"/>

                <Button fx:id="contractButton"
                        styleClass="nav-button"
                        maxWidth="Infinity"
                        onAction="#showContract"/>

                <Button fx:id="salaryButton"
                        styleClass="nav-button"
                        maxWidth="Infinity"
                        onAction="#showSalary"/>

                <Button fx:id="departmentButton"
                        styleClass="nav-button"
                        maxWidth="Infinity"
                        onAction="#showDepartment"/>

                <Button fx:id="settingsButton"
                        styleClass="nav-button"
                        maxWidth="Infinity"
                        onAction="#showSettings"/>
            </VBox>

            <HBox fx:id="expandedFooter"
                  styleClass="sidebar-footer"
                  alignment="CENTER"
                  spacing="8">
                <Button fx:id="languageButton"
                        styleClass="footer-icon-button"
                        onAction="#toggleLanguage"/>
                <Button fx:id="helpFooterButton"
                        text="?"
                        styleClass="footer-icon-button"
                        onAction="#showHelp"/>
                <Button fx:id="themeButton"
                        styleClass="footer-icon-button"
                        onAction="#toggleTheme"/>
            </HBox>

            <Button fx:id="themeButton2"
                    text="⚙"
                    styleClass="footer-icon-button"
                    visible="false"
                    managed="false"
                    onAction="#toggleTheme"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>
            <Label text="Welcome" styleClass="welcome-label"/>
        </StackPane>
    </center>

    <bottom>
        <HBox fx:id="statusBar" styleClass="status-bar" alignment="CENTER_LEFT">
            <padding>
                <Insets top="6" right="14" bottom="6" left="14"/>
            </padding>
            <Label fx:id="statusLabel" text="Ready"/>
        </HBox>
    </bottom>
</BorderPane>
