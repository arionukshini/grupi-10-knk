<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.company.system.controller.MyContractController"
            fitToWidth="true"
            styleClass="module-scroll">

    <content>
        <VBox spacing="20" styleClass="module-page">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="titleLabel" text="My Contract" styleClass="page-title"/>
                    <Label fx:id="statusBadgeLabel" text="-" styleClass="page-subtitle"/>
                </VBox>
                <Button fx:id="exportPdfButton"
                        text="Export Contract PDF"
                        onAction="#handleExportPdf"
                        styleClass="primary-button"/>
            </HBox>

            <HBox spacing="20" alignment="TOP_LEFT">
                <VBox spacing="16" HBox.hgrow="ALWAYS">
                    <VBox spacing="12" styleClass="content-card">
                        <Label fx:id="contractInfoTitleLabel" text="Contract information" styleClass="section-title"/>
                        <HBox spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="info-card">
                                <Label fx:id="contractTypeTitleLabel" text="Contract type" styleClass="info-card-label"/>
                                <Label fx:id="contractTypeLabel" text="-" styleClass="info-card-value"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="info-card">
                                <Label fx:id="statusTitleLabel" text="Status" styleClass="info-card-label"/>
                                <Label fx:id="statusLabel" text="-" styleClass="info-card-value"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="12" styleClass="content-card">
                        <Label fx:id="contractPeriodTitleLabel" text="Contract period" styleClass="section-title"/>
                        <HBox spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="salary-card-gross">
                                <Label fx:id="startDateTitleLabel" text="Start date" styleClass="salary-card-label"/>
                                <Label fx:id="startDateLabel" text="-" styleClass="info-card-value"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="salary-card-net">
                                <Label fx:id="endDateTitleLabel" text="End date" styleClass="salary-card-label"/>
                                <Label fx:id="endDateLabel" text="-" styleClass="info-card-value"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="12" styleClass="content-card">
                        <Label fx:id="contractSalaryTitleLabel" text="Contract salary" styleClass="section-title"/>
                        <VBox spacing="5" styleClass="salary-card-net">
                            <Label fx:id="monthlySalaryTitleLabel" text="Monthly salary" styleClass="salary-card-label"/>
                            <Label fx:id="salaryLabel" text="-" styleClass="salary-card-value-green"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="12" styleClass="content-card">
                        <Label fx:id="employeeInfoTitleLabel" text="Employee information" styleClass="section-title"/>
                        <HBox spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="info-card">
                                <Label fx:id="employeeNameTitleLabel" text="Name" styleClass="info-card-label"/>
                                <Label fx:id="employeeNameLabel" text="-" styleClass="info-card-value"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="info-card">
                                <Label fx:id="employeeIdTitleLabel" text="Employee ID" styleClass="info-card-label"/>
                                <Label fx:id="employeeIdLabel" text="-" styleClass="info-card-value"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox spacing="12" styleClass="content-card" minWidth="220" maxWidth="240">
                    <Label fx:id="detailsTitleLabel" text="Details" styleClass="section-title"/>
                    <Separator/>

                    <VBox spacing="5" styleClass="info-card">
                        <Label fx:id="contractIdTitleLabel" text="Contract ID" styleClass="info-card-label"/>
                        <Label fx:id="contractIdLabel" text="-" styleClass="info-card-value"/>
                    </VBox>

                    <VBox spacing="5" styleClass="info-card">
                        <Label fx:id="contractTypeSideTitleLabel" text="Type" styleClass="info-card-label"/>
                        <Label fx:id="contractTypeLabel2" text="-" styleClass="info-card-value"/>
                    </VBox>

                    <VBox spacing="5" styleClass="info-card">
                        <Label fx:id="statusSideTitleLabel" text="Status" styleClass="info-card-label"/>
                        <Label fx:id="statusLabel2" text="-" styleClass="info-card-value"/>
                    </VBox>

                    <Separator/>

                    <Label fx:id="exportHintLabel"
                           text="Click Export Contract PDF to download your contract."
                           wrapText="true"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
