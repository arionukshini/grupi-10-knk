<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.company.system.controller.MyContractController"
            fitToWidth="true"
            styleClass="module-scroll">

    <content>
        <VBox spacing="20" styleClass="module-page">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="My Contract" styleClass="page-title"/>
                    <Label fx:id="statusBadgeLabel" text="-" styleClass="page-subtitle"/>
                </VBox>
            </HBox>

            <!-- MAIN CONTENT -->
            <HBox spacing="20" alignment="TOP_LEFT">

                <!-- LEFT: CONTRACT DETAILS -->
                <VBox spacing="16" HBox.hgrow="ALWAYS">

                    <!-- SECTION 1: INFORMACIONI KRYESOR -->
                    <VBox spacing="12" styleClass="content-card">
                        <Label text="Informacioni i kontratës" styleClass="section-title"/>
                        <HBox spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="info-card">
                                <Label text="Lloji i kontratës" styleClass="info-card-label"/>
                                <Label fx:id="contractTypeLabel" text="-" styleClass="info-card-value"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="info-card">
                                <Label text="Statusi" styleClass="info-card-label"/>
                                <Label fx:id="statusLabel" text="-" styleClass="info-card-value"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- SECTION 2: DATAT -->
                    <VBox spacing="12" styleClass="content-card">
                        <Label text="Periudha e kontratës" styleClass="section-title"/>
                        <HBox spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="salary-card-gross">
                                <Label text="Data e fillimit" styleClass="salary-card-label"/>
                                <Label fx:id="startDateLabel" text="-" styleClass="info-card-value"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="salary-card-net">
                                <Label text="Data e mbarimit" styleClass="salary-card-label"/>
                                <Label fx:id="endDateLabel" text="-" styleClass="info-card-value"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- SECTION 3: PAGA -->
                    <VBox spacing="12" styleClass="content-card">
                        <Label text="Paga bazë e kontratës" styleClass="section-title"/>
                        <VBox spacing="5" styleClass="salary-card-net">
                            <Label text="Paga mujore" styleClass="salary-card-label"/>
                            <Label fx:id="salaryLabel" text="-" styleClass="salary-card-value-green"/>
                        </VBox>
                    </VBox>

                    <!-- SECTION 4: PUNETORI -->
                    <VBox spacing="12" styleClass="content-card">
                        <Label text="Të dhënat e punëtorit" styleClass="section-title"/>
                        <HBox spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="info-card">
                                <Label text="Emri" styleClass="info-card-label"/>
                                <Label fx:id="employeeNameLabel" text="-" styleClass="info-card-value"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="info-card">
                                <Label text="ID Punëtori" styleClass="info-card-label"/>
                                <Label fx:id="employeeIdLabel" text="-" styleClass="info-card-value"/>
                            </VBox>
                        </HBox>
                    </VBox>

                </VBox>

                <!-- RIGHT: KONTRATA ID + INFO SHTESE -->
                <VBox spacing="12" styleClass="content-card" minWidth="220" maxWidth="240">
                    <Label text="Detajet" styleClass="section-title"/>
                    <Separator/>

                    <VBox spacing="5" styleClass="info-card">
                        <Label text="Contract ID" styleClass="info-card-label"/>
                        <Label fx:id="contractIdLabel" text="-" styleClass="info-card-value"/>
                    </VBox>

                    <VBox spacing="5" styleClass="info-card">
                        <Label text="Lloji" styleClass="info-card-label"/>
                        <Label fx:id="contractTypeLabel2" text="-" styleClass="info-card-value"/>
                    </VBox>

                    <VBox spacing="5" styleClass="info-card">
                        <Label text="Statusi" styleClass="info-card-label"/>
                        <Label fx:id="statusLabel2" text="-" styleClass="info-card-value"/>
                    </VBox>

                </VBox>

            </HBox>

        </VBox>
    </content>
</ScrollPane>
