<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.company.system.controller.WelcomeController"
            prefHeight="620"
            prefWidth="1000"
            style="-fx-background-color: linear-gradient(to bottom right, #19316c 0%, #126aa0 48%, #01b3c9 100%);">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18"
              style="-fx-padding: 22 34 10 34;">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="appTitleLabel"
                       text="Contract and Salary Management System"
                       textFill="WHITE"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <Label fx:id="headerSubtitleLabel"
                       text="Employee, contract and payroll management"
                       textFill="WHITE"
                       wrapText="true"
                       style="-fx-opacity: 0.88; -fx-font-size: 13px;"/>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="albanianButton"
                        text="SQ"
                        onAction="#switchToAlbanian"
                        prefWidth="58"
                        prefHeight="36"
                        focusTraversable="true"/>
                <Button fx:id="englishButton"
                        text="EN"
                        onAction="#switchToEnglish"
                        prefWidth="58"
                        prefHeight="36"
                        focusTraversable="true"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox alignment="CENTER"
                      spacing="24"
                      minHeight="500"
                      style="-fx-background-color: transparent;">
                    <padding>
                        <Insets top="22" right="36" bottom="36" left="36"/>
                    </padding>

                    <HBox alignment="CENTER"
                          spacing="30"
                          maxWidth="930"
                          style="-fx-background-color: rgba(255, 255, 255, 0.14);
                                 -fx-background-radius: 8;
                                 -fx-border-radius: 8;
                                 -fx-border-color: rgba(255, 255, 255, 0.32);
                                 -fx-effect: dropshadow(gaussian, rgba(5, 20, 40, 0.26), 24, 0.18, 0, 8);">
                        <padding>
                            <Insets top="34" right="34" bottom="34" left="34"/>
                        </padding>

                        <VBox alignment="CENTER_LEFT" spacing="20" HBox.hgrow="ALWAYS" maxWidth="520">
                            <Label fx:id="welcomeLabel"
                                   text="Welcome to the Contract and Salary Management System"
                                   wrapText="true"
                                   textAlignment="LEFT"
                                   alignment="CENTER_LEFT"
                                   style="-fx-font-size: 38px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: white;
                                          -fx-line-spacing: 2;"/>

                            <Label fx:id="subtitleLabel"
                                   text="Manage employees, contracts and salaries in one system."
                                   wrapText="true"
                                   textAlignment="LEFT"
                                   alignment="CENTER_LEFT"
                                   style="-fx-font-size: 16px;
                                          -fx-text-fill: rgba(255, 255, 255, 0.88);
                                          -fx-line-spacing: 4;"/>

                            <Button fx:id="accessButton"
                                    text="Enter"
                                    onAction="#openLogin"
                                    prefHeight="52"
                                    prefWidth="220"
                                    focusTraversable="true"/>
                        </VBox>

                        <VBox spacing="12" minWidth="280" maxWidth="310">
                            <VBox alignment="CENTER_LEFT" spacing="7" prefHeight="104"
                                  style="-fx-background-color: rgba(255, 255, 255, 0.92);
                                         -fx-background-radius: 8;
                                         -fx-border-color: rgba(255, 255, 255, 0.72);
                                         -fx-border-radius: 8;
                                         -fx-padding: 16;">
                                <Label fx:id="employeesCardTitle" text="Employees"
                                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #19316c;"/>
                                <Label fx:id="employeesCardText" text="Manage employee records"
                                       wrapText="true"
                                       style="-fx-text-fill: #52606d; -fx-font-size: 13px;"/>
                            </VBox>

                            <VBox alignment="CENTER_LEFT" spacing="7" prefHeight="104"
                                  style="-fx-background-color: rgba(255, 255, 255, 0.92);
                                         -fx-background-radius: 8;
                                         -fx-border-color: rgba(255, 255, 255, 0.72);
                                         -fx-border-radius: 8;
                                         -fx-padding: 16;">
                                <Label fx:id="contractsCardTitle" text="Contracts"
                                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #19316c;"/>
                                <Label fx:id="contractsCardText" text="Track contracts and agreements"
                                       wrapText="true"
                                       style="-fx-text-fill: #52606d; -fx-font-size: 13px;"/>
                            </VBox>

                            <VBox alignment="CENTER_LEFT" spacing="7" prefHeight="104"
                                  style="-fx-background-color: rgba(255, 255, 255, 0.92);
                                         -fx-background-radius: 8;
                                         -fx-border-color: rgba(255, 255, 255, 0.72);
                                         -fx-border-radius: 8;
                                         -fx-padding: 16;">
                                <Label fx:id="salariesCardTitle" text="Salaries"
                                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #19316c;"/>
                                <Label fx:id="salariesCardText" text="Review payroll information"
                                       wrapText="true"
                                       style="-fx-text-fill: #52606d; -fx-font-size: 13px;"/>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" prefHeight="44"
              style="-fx-background-color: rgba(4, 29, 60, 0.30);">
            <Label text="Contract &amp; Payroll System"
                   textFill="WHITE"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-opacity: 0.82;"/>
        </HBox>
    </bottom>
</BorderPane>
