<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.company.system.controller.WelcomeController"
            prefHeight="620"
            prefWidth="1000"
            style="-fx-background-color: #f4f6f8;">

    <top>
        <AnchorPane prefHeight="104"
                    style="-fx-background-color: linear-gradient(to right, #19316c, #01b3c9);">
            <children>
                <Label fx:id="appTitleLabel"
                       text="Contract and Salary Management System"
                       textFill="WHITE"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;"
                       AnchorPane.leftAnchor="36"
                       AnchorPane.topAnchor="26"/>

                <Label fx:id="headerSubtitleLabel"
                       text="Employee, contract and payroll management"
                       textFill="WHITE"
                       style="-fx-opacity: 0.9; -fx-font-size: 14px;"
                       AnchorPane.leftAnchor="36"
                       AnchorPane.topAnchor="62"/>

                <HBox alignment="CENTER_RIGHT"
                      spacing="10"
                      AnchorPane.rightAnchor="32"
                      AnchorPane.topAnchor="32">
                    <Button fx:id="albanianButton"
                            text="SQ"
                            onAction="#switchToAlbanian"
                            prefWidth="58"/>
                    <Button fx:id="englishButton"
                            text="EN"
                            onAction="#switchToEnglish"
                            prefWidth="58"/>
                </HBox>
            </children>
        </AnchorPane>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: linear-gradient(to bottom, #eaf7fb, #f8fafc); -fx-background: transparent;">
            <content>
                <VBox alignment="CENTER"
                      spacing="26"
                      minHeight="464"
                      style="-fx-background-color: linear-gradient(to bottom, #eaf7fb, #f8fafc);">
                    <padding>
                        <Insets top="42" right="32" bottom="42" left="32"/>
                    </padding>

                    <Label fx:id="welcomeLabel"
                           text="Welcome to the Contract and Salary Management System"
                           wrapText="true"
                           textAlignment="CENTER"
                           alignment="CENTER"
                           maxWidth="820"
                           style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #102a43;"/>

                    <Label fx:id="subtitleLabel"
                           text="Manage employees, contracts and salaries in one system."
                           wrapText="true"
                           textAlignment="CENTER"
                           alignment="CENTER"
                           maxWidth="720"
                           style="-fx-font-size: 16px; -fx-text-fill: #486581;"/>

                    <FlowPane alignment="CENTER"
                              hgap="18"
                              vgap="18"
                              maxWidth="820"
                              prefWrapLength="780">

                <VBox alignment="CENTER"
                      spacing="8"
                      prefWidth="240"
                      prefHeight="112"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d9e2ec; -fx-border-radius: 8;">
                    <Label fx:id="employeesCardTitle"
                           text="Employees"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #19316c;"/>
                    <Label fx:id="employeesCardText"
                           text="Manage employee records"
                           wrapText="true"
                           textAlignment="CENTER"
                           style="-fx-text-fill: #52606d;"/>
                </VBox>

                <VBox alignment="CENTER"
                      spacing="8"
                      prefWidth="240"
                      prefHeight="112"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d9e2ec; -fx-border-radius: 8;">
                    <Label fx:id="contractsCardTitle"
                           text="Contracts"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #19316c;"/>
                    <Label fx:id="contractsCardText"
                           text="Track contracts and agreements"
                           wrapText="true"
                           textAlignment="CENTER"
                           style="-fx-text-fill: #52606d;"/>
                </VBox>

                <VBox alignment="CENTER"
                      spacing="8"
                      prefWidth="240"
                      prefHeight="112"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d9e2ec; -fx-border-radius: 8;">
                    <Label fx:id="salariesCardTitle"
                           text="Salaries"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #19316c;"/>
                    <Label fx:id="salariesCardText"
                           text="Review payroll information"
                           wrapText="true"
                           textAlignment="CENTER"
                           style="-fx-text-fill: #52606d;"/>
                </VBox>

                    </FlowPane>

                    <Button fx:id="accessButton"
                            text="Enter"
                            onAction="#openLogin"
                            prefHeight="54"
                            prefWidth="220"
                            style="-fx-background-color: linear-gradient(to right, #19316c, #01b3c9); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER"
              prefHeight="52"
              style="-fx-background-color: linear-gradient(to right, #19316c, #01b3c9);">
            <Label text="Contract &amp; Payroll System"
                   textFill="WHITE"
                   style="-fx-font-weight: bold;"/>
        </HBox>
    </bottom>
</BorderPane>
