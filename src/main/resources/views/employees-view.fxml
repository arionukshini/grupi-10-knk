<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.company.system.controller.EmployeesController"
            fitToWidth="true"
            pannable="true"
            style="-fx-background-color: #f8fafc; -fx-background: #f8fafc;">

    <content>
        <VBox spacing="18"
              style="-fx-padding: 24; -fx-background-color: #f8fafc;">

            <VBox spacing="4">
                <Label fx:id="titleLabel"
                       text="Punetoret"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                <Label text="Menaxhoni punetoret dhe te dhenat e tyre nga databaza."
                       style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
            </VBox>

            <HBox spacing="12"
                  style="-fx-background-color: white; -fx-padding: 14; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8;">
                <TextField fx:id="searchField"
                           promptText="Kerko sipas emrit, emailit, pozites ose statusit"
                           prefWidth="420"/>
            </HBox>

            <TableView fx:id="employeesTable"
                       prefHeight="300"
                       style="-fx-background-color: white; -fx-border-color: #d9e2ec; -fx-border-radius: 8;">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="55"/>
                    <TableColumn fx:id="firstNameColumn" text="Emri" prefWidth="105"/>
                    <TableColumn fx:id="lastNameColumn" text="Mbiemri" prefWidth="105"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="190"/>
                    <TableColumn fx:id="phoneColumn" text="Telefoni" prefWidth="105"/>
                    <TableColumn fx:id="positionColumn" text="Pozita" prefWidth="145"/>
                    <TableColumn fx:id="departmentColumn" text="Dept. ID" prefWidth="80"/>
                    <TableColumn fx:id="hireDateColumn" text="Data" prefWidth="105"/>
                    <TableColumn fx:id="salaryColumn" text="Paga" prefWidth="90"/>
                    <TableColumn fx:id="statusColumn" text="Statusi" prefWidth="90"/>
                </columns>
            </TableView>

            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8;">

                <Label text="Forma e punetorit"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                <GridPane hgap="12" vgap="12">
                    <TextField fx:id="firstNameField"
                               promptText="Emri"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"/>

                    <TextField fx:id="lastNameField"
                               promptText="Mbiemri"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                    <TextField fx:id="emailField"
                               promptText="Email"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="2"/>

                    <TextField fx:id="phoneField"
                               promptText="Telefoni"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>

                    <TextField fx:id="positionField"
                               promptText="Pozita"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                    <TextField fx:id="departmentIdField"
                               promptText="Department ID"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="2"/>

                    <DatePicker fx:id="hireDatePicker"
                                promptText="Data e punesimit"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="0"/>

                    <TextField fx:id="salaryField"
                               promptText="Paga baze"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>

                    <ComboBox fx:id="statusField"
                              value="Active"
                              prefWidth="150"
                              GridPane.rowIndex="2"
                              GridPane.columnIndex="2">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Active"/>
                                <String fx:value="Pending"/>
                                <String fx:value="Inactive"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </GridPane>

                <HBox spacing="10">
                    <Button fx:id="addButton"
                            text="Shto"
                            onAction="#addEmployee"
                            style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <Button fx:id="updateButton"
                            text="Perditeso"
                            onAction="#updateEmployee"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <Button fx:id="deleteButton"
                            text="Fshi"
                            onAction="#deleteEmployee"
                            style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <Button fx:id="clearButton"
                            text="Pastro"
                            onAction="#clearForm"/>
                </HBox>
            </VBox>

        </VBox>
    </content>
</ScrollPane>