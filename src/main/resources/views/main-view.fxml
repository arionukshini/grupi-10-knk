<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.company.system.controller.MainController">

    <!-- ================= TOP ================= -->

    <top>
        <VBox spacing="5">

            <padding>
                <Insets top="5" right="5" bottom="5" left="5"/>
            </padding>

            <!-- MENU BAR -->

            <MenuBar>

                <menus>

                    <!-- FILE -->

                    <Menu fx:id="fileMenu" text="File">

                        <items>

                            <MenuItem fx:id="exitMenuItem"
                                      text="Exit"
                                      onAction="#handleExit"/>

                        </items>

                    </Menu>

                    <!-- MANAGE -->

                    <Menu fx:id="manageMenu" text="Manage">

                        <items>

                            <MenuItem fx:id="employeesMenuItem"
                                      text="Employees"
                                      onAction="#showEmployees"/>

                            <MenuItem fx:id="contractsMenuItem"
                                      text="Contracts"
                                      onAction="#showContracts"/>

                            <MenuItem fx:id="salariesMenuItem"
                                      text="Salaries"
                                      onAction="#showSalaries"/>

                        </items>

                    </Menu>

                    <!-- VIEW -->

                    <Menu fx:id="viewMenu" text="View">

                        <items>

                            <MenuItem fx:id="dashboardMenuItem"
                                      text="Dashboard"
                                      onAction="#showDashboard"/>

                        </items>

                    </Menu>

                    <!-- HELP -->

                    <Menu fx:id="helpMenu" text="Help">

                        <items>

                            <MenuItem fx:id="helpMenuItem"
                                      text="Help"
                                      onAction="#showHelp"/>

                        </items>

                    </Menu>

                    <!-- ACCOUNT -->

                    <Menu fx:id="accountMenu" text="Account">

                        <items>

                            <MenuItem fx:id="accountMenuItem"
                                      text="Account"
                                      onAction="#showAccount"/>

                        </items>

                    </Menu>

                </menus>

            </MenuBar>

            <!-- TOOLBAR -->

            <ToolBar>

                <Button text="Employees"
                        onAction="#showEmployees"/>

                <Button text="Contracts"
                        onAction="#showContracts"/>

                <Button text="Salaries"
                        onAction="#showSalaries"/>

                <Button text="Dashboard"
                        onAction="#showDashboard"/>

            </ToolBar>

        </VBox>
    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <StackPane fx:id="contentArea">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <children>

                <Label fx:id="welcomeLabel"
                       text="Welcome to Contract &amp; Payroll System"/>

            </children>

        </StackPane>

    </center>

    <!-- ================= BOTTOM ================= -->

    <bottom>

        <HBox spacing="10">

            <padding>
                <Insets top="5" right="5" bottom="5" left="5"/>
            </padding>

            <children>

                <Label fx:id="statusLabel"
                       text="Ready"/>

            </children>

        </HBox>

    </bottom>

</BorderPane>