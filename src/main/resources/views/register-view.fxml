<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.company.system.controller.RegisterController"
            prefHeight="500" prefWidth="400"
            style="-fx-background-color: #f4f6f8;">

    <VBox alignment="CENTER" spacing="15"
          AnchorPane.leftAnchor="50"
          AnchorPane.rightAnchor="50"
          AnchorPane.topAnchor="80">

        <padding>
            <Insets top="20" bottom="20" left="20" right="20"/>
        </padding>

        <Label text="Register"
               style="-fx-font-size: 28px; -fx-font-weight: bold;" />

        <TextField fx:id="usernameField"
                   promptText="Username"
                   prefHeight="40"/>

        <PasswordField fx:id="passwordField"
                       promptText="Password"
                       prefHeight="40"/>

        <Button text="Register"
                onAction="#handleRegister"
                prefWidth="200"
                style="-fx-background-color: #16a34a; -fx-text-fill: white;"/>

        <Button text="Back to Login"
                onAction="#goToLogin"
                prefWidth="200"/>

        <Label fx:id="messageLabel"
               style="-fx-text-fill: red;"/>
    </VBox>

</AnchorPane>