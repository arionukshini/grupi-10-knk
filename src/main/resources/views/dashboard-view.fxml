<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.company.system.controller.DashboardController"
            fitToWidth="true"
            pannable="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="dashboard-scroll">
    <content>
        <VBox spacing="20"
              styleClass="dashboard-page">
            <padding>
                <Insets top="28" right="28" bottom="28" left="28"/>
            </padding>

            <VBox spacing="4">
                <Label fx:id="dashboardTitleLabel"
                       text="Dashboard"
                       styleClass="page-title"/>
                <Label fx:id="dashboardSubtitleLabel"
                       text="Overview of employees, contracts and salaries"
                       wrapText="true"
                       styleClass="page-subtitle"/>
            </VBox>

            <FlowPane hgap="18" vgap="18"
                      prefWrapLength="900">
                <VBox spacing="10" prefWidth="205" minHeight="118" styleClass="metric-card">
                    <Label fx:id="employeesTitleLabel" text="Employees" styleClass="card-title"/>
                    <Label fx:id="totalEmployeesLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox spacing="10" prefWidth="205" minHeight="118" styleClass="metric-card">
                    <Label fx:id="contractsTitleLabel" text="Contracts" styleClass="card-title"/>
                    <Label fx:id="totalContractsLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox spacing="10" prefWidth="205" minHeight="118" styleClass="metric-card">
                    <Label fx:id="salariesTitleLabel" text="Salaries" styleClass="card-title"/>
                    <Label fx:id="totalSalariesLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox spacing="10" prefWidth="205" minHeight="118" styleClass="metric-card">
                    <Label fx:id="averageSalaryTitleLabel" text="Average salary" styleClass="card-title"/>
                    <Label fx:id="averageSalaryLabel" text="0.00 EUR" styleClass="metric-value"/>
                </VBox>
                <VBox spacing="10" prefWidth="205" minHeight="118" styleClass="metric-card">
                    <Label fx:id="activeContractsTitleLabel" text="Active contracts" styleClass="card-title"/>
                    <Label fx:id="activeContractsLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox spacing="10" prefWidth="205" minHeight="118" styleClass="metric-card">
                    <Label fx:id="pendingContractsTitleLabel" text="Pending contracts" styleClass="card-title"/>
                    <Label fx:id="pendingContractsLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox spacing="10" prefWidth="205" minHeight="118" styleClass="metric-card">
                    <Label fx:id="expiredContractsTitleLabel" text="Expired contracts" styleClass="card-title"/>
                    <Label fx:id="expiredContractsLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox spacing="10" prefWidth="205" minHeight="118" styleClass="metric-card">
                    <Label fx:id="expiringContractsTitleLabel" text="Expiring soon" styleClass="card-title"/>
                    <Label fx:id="expiringContractsLabel" text="0" styleClass="metric-value"/>
                </VBox>
            </FlowPane>

            <VBox spacing="18">
                <VBox spacing="10" maxWidth="Infinity" styleClass="content-card">
                    <BarChart fx:id="employeesChart"
                              minWidth="0"
                              prefHeight="300"
                              maxWidth="Infinity"
                              legendVisible="false"
                              animated="false">
                        <xAxis>
                            <CategoryAxis fx:id="xAxis"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="yAxis"/>
                        </yAxis>
                    </BarChart>
                </VBox>
                <VBox spacing="12" maxWidth="Infinity" minHeight="180" styleClass="content-card">
                    <Label fx:id="insightTitleLabel"
                           text="Insight"
                           styleClass="section-title"/>
                    <Label fx:id="aiInsightLabel"
                           text="No insight"
                           wrapText="true"
                           styleClass="body-text"/>
                </VBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
