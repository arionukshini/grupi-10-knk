<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.company.system.controller.DashboardController"
            fitToWidth="true"
            pannable="true"
            style="-fx-background-color: #f8fafc; -fx-background: #f8fafc;">
    <content>
        <VBox spacing="20"
              minWidth="920"
              style="-fx-padding: 28; -fx-background-color: #f8fafc;">
            <VBox spacing="4">
                <Label fx:id="dashboardTitleLabel"
                       text="Paneli kryesor"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Label fx:id="dashboardSubtitleLabel"
                       text="Permbledhje e punetoreve, kontratave dhe pagave"
                       style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
            </VBox>
            <GridPane hgap="18" vgap="18">
                <padding>
                    <Insets top="8" right="0" bottom="4" left="0"/>
                </padding>
                <VBox GridPane.rowIndex="0" GridPane.columnIndex="0"
                      spacing="10"
                      prefWidth="205"
                      minHeight="118"
                      style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.08), 12, 0, 0, 4);">
                    <Label fx:id="employeesTitleLabel"
                           text="Punetoret"
                           style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="totalEmployeesLabel"
                           text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </VBox>
                <VBox GridPane.rowIndex="0" GridPane.columnIndex="1"
                      spacing="10"
                      prefWidth="205"
                      minHeight="118"
                      style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.08), 12, 0, 0, 4);">
                    <Label fx:id="contractsTitleLabel"
                           text="Kontratat"
                           style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="totalContractsLabel"
                           text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </VBox>
                <VBox GridPane.rowIndex="0" GridPane.columnIndex="2"
                      spacing="10"
                      prefWidth="205"
                      minHeight="118"
                      style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.08), 12, 0, 0, 4);">
                    <Label fx:id="salariesTitleLabel"
                           text="Pagat"
                           style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="totalSalariesLabel"
                           text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </VBox>
                <VBox GridPane.rowIndex="0" GridPane.columnIndex="3"
                      spacing="10"
                      prefWidth="205"
                      minHeight="118"
                      style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.08), 12, 0, 0, 4);">
                    <Label fx:id="averageSalaryTitleLabel"
                           text="Paga mesatare"
                           style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="averageSalaryLabel"
                           text="0.00 EUR"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </VBox>
                <VBox GridPane.rowIndex="1" GridPane.columnIndex="0"
                      spacing="10"
                      prefWidth="205"
                      minHeight="118"
                      style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.08), 12, 0, 0, 4);">
                    <Label fx:id="activeContractsTitleLabel"
                           text="Kontratat aktive"
                           style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="activeContractsLabel"
                           text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </VBox>
                <VBox GridPane.rowIndex="1" GridPane.columnIndex="1"
                      spacing="10"
                      prefWidth="205"
                      minHeight="118"
                      style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.08), 12, 0, 0, 4);">
                    <Label fx:id="pendingContractsTitleLabel"
                           text="Kontratat ne pritje"
                           style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="pendingContractsLabel"
                           text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </VBox>
                <VBox GridPane.rowIndex="1" GridPane.columnIndex="2"
                      spacing="10"
                      prefWidth="205"
                      minHeight="118"
                      style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.08), 12, 0, 0, 4);">
                    <Label fx:id="expiredContractsTitleLabel"
                           text="Kontratat e skaduara"
                           style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="expiredContractsLabel"
                           text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </VBox>
                <VBox GridPane.rowIndex="1" GridPane.columnIndex="3"
                      spacing="10"
                      prefWidth="205"
                      minHeight="118"
                      style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.08), 12, 0, 0, 4);">
                    <Label fx:id="expiringContractsTitleLabel"
                           text="Skadojne se shpejti"
                           style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="expiringContractsLabel"
                           text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </VBox>
            </GridPane>
            <HBox spacing="20">
                <VBox spacing="10"
                      style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.08), 12, 0, 0, 4);">
                    <BarChart fx:id="employeesChart"
                              prefHeight="280"
                              prefWidth="610"
                              legendVisible="false"
                              animated="false">
                        <xAxis>
                            <CategoryAxis fx:id="xAxis"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="yAxis"/>
                        </yAxis>
                    </BarChart>
                </VBox>
                <VBox spacing="12"
                      prefWidth="280"
                      minHeight="280"
                      style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.08), 12, 0, 0, 4);">
                    <Label fx:id="insightTitleLabel"
                           text="Verejtje"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label fx:id="aiInsightLabel"
                           text="Nuk ka verejtje"
                           wrapText="true"
                           style="-fx-font-size: 14px; -fx-text-fill: #334155; -fx-line-spacing: 4;"/>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>