<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.company.system.controller.DashboardController">

    <top>
        <VBox spacing="10">

            <padding>
                <Insets top="15"
                        right="15"
                        bottom="15"
                        left="15"/>
            </padding>

            <Label text="Dashboard"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;"/>

        </VBox>
    </top>

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <!-- STATISTICS -->

            <HBox spacing="20">

                <VBox spacing="5"
                      style="-fx-background-color: #E3F2FD;
                             -fx-padding: 15;
                             -fx-background-radius: 10;">

                    <Label text="Employees"/>

                    <Label fx:id="totalEmployeesLabel"
                           text="0"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="5"
                      style="-fx-background-color: #E8F5E9;
                             -fx-padding: 15;
                             -fx-background-radius: 10;">

                    <Label text="Departments"/>

                    <Label fx:id="totalDepartmentsLabel"
                           text="0"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="5"
                      style="-fx-background-color: #FFF3E0;
                             -fx-padding: 15;
                             -fx-background-radius: 10;">

                    <Label text="Active Contracts"/>

                    <Label fx:id="activeContractsLabel"
                           text="0"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="5"
                      style="-fx-background-color: #F3E5F5;
                             -fx-padding: 15;
                             -fx-background-radius: 10;">

                    <Label text="Average Salary"/>

                    <Label fx:id="averageSalaryLabel"
                           text="0"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>
                </VBox>

            </HBox>

            <!-- CHART -->

            <BarChart fx:id="employeesChart"
                      prefHeight="400"
                      title="Employees per Department">

                <xAxis>
                    <CategoryAxis label="Department"/>
                </xAxis>

                <yAxis>
                    <NumberAxis label="Employees"/>
                </yAxis>

            </BarChart>

        </VBox>

    </center>

    <bottom>

        <HBox style="-fx-background-color: #EEEEEE;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label fx:id="aiInsightLabel"
                   text="AI Insight"
                   style="-fx-font-size: 14px;
                          -fx-font-weight: bold;"/>

        </HBox>

    </bottom>

</BorderPane>