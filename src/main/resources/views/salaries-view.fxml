<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.company.system.controller.SalariesController"
            fitToWidth="true"
            pannable="true"
            styleClass="module-scroll">

    <content>
        <VBox spacing="18" styleClass="module-page">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="4">
                <Label fx:id="titleLabel" text="Pagat" styleClass="page-title"/>
                <Label fx:id="subtitleLabel" text="Menaxhoni pagat dhe historikun e pagesave te punetoreve." styleClass="page-subtitle"/>
            </VBox>

            <TableView fx:id="salariesTable" prefHeight="280">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="55"/>
                    <TableColumn fx:id="employeeColumn" text="Punetori ID" prefWidth="90"/>
                    <TableColumn fx:id="employeeNameColumn" text="Punetori" prefWidth="150"/>
                    <TableColumn fx:id="grossColumn" text="Bruto" prefWidth="110"/>
                    <TableColumn fx:id="bonusColumn" text="Bonusi" prefWidth="100"/>
                    <TableColumn fx:id="deductionsColumn" text="Zbritje" prefWidth="100"/>
                    <TableColumn fx:id="workedDaysColumn" text="Dite Pune" prefWidth="95"/>
                    <TableColumn fx:id="vacationColumn" text="Pushime" prefWidth="90"/>
                    <TableColumn fx:id="workHoursColumn" text="Ore Pune" prefWidth="100"/>
                    <TableColumn fx:id="overtimeColumn" text="Jasht Orari" prefWidth="110"/>
                    <TableColumn fx:id="netColumn" text="Neto" prefWidth="110"/>
                    <TableColumn fx:id="dateColumn" text="Data" prefWidth="120"/>
                </columns>
            </TableView>

            <VBox spacing="14" styleClass="content-card">
                <Label fx:id="formTitleLabel" text="Forma e pageses" styleClass="section-title"/>

                <GridPane hgap="12" vgap="12">
                    <TextField fx:id="employeeIdField" promptText="Employee ID" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="baseSalaryField" promptText="Paga baze" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <TextField fx:id="workedDaysField" promptText="Ditet e punes" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <TextField fx:id="vacationDaysField" promptText="Ditet e pushimit" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="workHoursField" promptText="Oret e punes" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <TextField fx:id="overtimeHoursField" promptText="Oret shtese" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <TextField fx:id="bonusField" promptText="Bonusi" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="deductionsField" promptText="Zbritjet" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <DatePicker fx:id="paymentDatePicker" promptText="Data e pageses" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                </GridPane>

                <HBox spacing="10">
                    <Button fx:id="calculateButton" text="Kalkulo" onAction="#handleCalculateSalary" styleClass="primary-button"/>
                    <Button fx:id="updateButton" text="Perditeso" onAction="#handleUpdateSalary" styleClass="primary-button"/>
                    <Button fx:id="deleteButton" text="Fshi" onAction="#handleDeleteSalary" styleClass="danger-button"/>
                    <Button fx:id="clearButton" text="Pastro" onAction="#clearFields" styleClass="secondary-button"/>
                </HBox>
            </VBox>

            <VBox spacing="12" styleClass="content-card">
                <Label fx:id="historyTitleLabel" text="Historiku i pagave" styleClass="section-title"/>

                <TableView fx:id="historyTable" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="historyDateColumn" text="Data" prefWidth="150"/>
                        <TableColumn fx:id="historyGrossColumn" text="Bruto" prefWidth="150"/>
                        <TableColumn fx:id="historyBonusColumn" text="Bonusi" prefWidth="150"/>
                        <TableColumn fx:id="historyNetColumn" text="Neto" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
