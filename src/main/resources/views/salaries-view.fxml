<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.company.system.controller.SalariesController"
            fitToWidth="true"
            pannable="true">
    <content>
        <VBox spacing="18">
            <VBox spacing="4">
                <Label text="Pagat"/>
                <Label text="Llogaritja mujore përfshin..."/>
            </VBox>
            <TableView fx:id="salariesTable"
                       prefHeight="280">
                <TableColumn fx:id="idColumn" text="ID" prefWidth="55"/>
                <TableColumn fx:id="employeeColumn" text="Punëtori ID" prefWidth="95"/>
                <TableColumn fx:id="grossColumn" text="Bruto"/>
                <TableColumn fx:id="bonusColumn" text="Bonus"/>
                <TableColumn fx:id="deductionsColumn" text="Zbritje"/>
                <TableColumn fx:id="vacationColumn" text="Pushime"/>
                <TableColumn fx:id="workHoursColumn" text="Orë pune"/>
                <TableColumn fx:id="overtimeColumn" text="Orë shtesë"/>
                <TableColumn fx:id="netColumn" text="Neto"/>
                <TableColumn fx:id="dateColumn" text="Data"/>
            </TableView>
        </VBox>
    </content>
</ScrollPane>