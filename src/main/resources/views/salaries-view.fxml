<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.company.system.controller.SalariesController"
            fitToWidth="true"
            pannable="true"
            style="-fx-background-color: #f8fafc; -fx-background: #f8fafc;">

    <content>
        <VBox spacing="18"
              style="-fx-padding: 24; -fx-background-color: #f8fafc;">

            <!-- Title -->
            <VBox spacing="4">
                <Label text="Pagat"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                <Label text="Menaxhoni pagat dhe historikun e pagesave te punetoreve."
                       style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
            </VBox>

            <!-- Salaries Table -->
            <TableView fx:id="salariesTable"
                       prefHeight="280"
                       style="-fx-background-color: white; -fx-border-color: #d9e2ec; -fx-border-radius: 8;">

                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="55"/>

                    <TableColumn fx:id="employeeColumn"
                                 text="Punetori"
                                 prefWidth="90"/>

                    <TableColumn fx:id="grossColumn"
                                 text="Bruto"
                                 prefWidth="110"/>

                    <TableColumn fx:id="bonusColumn"
                                 text="Bonusi"
                                 prefWidth="100"/>

                    <TableColumn fx:id="deductionsColumn"
                                 text="Zbritje"
                                 prefWidth="100"/>

                    <TableColumn fx:id="vacationColumn"
                                 text="Pushime"
                                 prefWidth="90"/>

                    <TableColumn fx:id="workHoursColumn"
                                 text="Ore Pune"
                                 prefWidth="100"/>

                    <TableColumn fx:id="overtimeColumn"
                                 text="Jasht Orari"
                                 prefWidth="110"/>

                    <TableColumn fx:id="netColumn"
                                 text="Neto"
                                 prefWidth="110"/>

                    <TableColumn fx:id="dateColumn"
                                 text="Data"
                                 prefWidth="120"/>
                </columns>
            </TableView>

            <!-- Salary Form -->
            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8;">

                <Label text="Forma e pageses"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                <GridPane hgap="12" vgap="12">

                    <TextField fx:id="employeeIdField"
                               promptText="Employee ID"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"/>

                    <TextField fx:id="baseSalaryField"
                               promptText="Paga baze"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                    <TextField fx:id="workedDaysField"
                               promptText="Ditet e punes"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="2"/>

                    <TextField fx:id="vacationDaysField"
                               promptText="Ditet e pushimit"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>

                    <TextField fx:id="workHoursField"
                               promptText="Oret e punes"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                    <TextField fx:id="overtimeHoursField"
                               promptText="Oret shtese"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="2"/>

                    <TextField fx:id="bonusField"
                               promptText="Bonusi"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="0"/>

                    <TextField fx:id="deductionsField"
                               promptText="Zbritjet"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>

                    <DatePicker fx:id="paymentDatePicker"
                                promptText="Data e pageses"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="2"/>
                </GridPane>

                <!-- Buttons -->
                <HBox spacing="10">

                    <Button fx:id="calculateButton"
                            text="Kalkulo"
                            onAction="#handleCalculateSalary"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <Button fx:id="saveButton"
                            text="Ruaj"
                            onAction="#handleSaveSalary"
                            style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <Button fx:id="deleteButton"
                            text="Fshi"
                            onAction="#handleDeleteSalary"
                            style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <Button text="Perditeso"
                            onAction="#handleUpdateSalary"
                            style="-fx-background-color: #2563eb;
                            -fx-text-fill: white;
                            -fx-font-weight: bold;"/>

                    <Button text="Pastro"
                            onAction="#clearFields"/>
                </HBox>
            </VBox>

            <!-- Salary History -->
            <VBox spacing="12"
                  style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #d9e2ec; -fx-border-radius: 8; -fx-background-radius: 8;">

                <Label text="Historiku i pagave"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                <TableView fx:id="historyTable"
                           prefHeight="220"
                           style="-fx-background-color: white; -fx-border-color: #d9e2ec; -fx-border-radius: 8;">

                    <columns>

                        <TableColumn fx:id="historyDateColumn"
                                     text="Data"
                                     prefWidth="150"/>

                        <TableColumn fx:id="historyGrossColumn"
                                     text="Bruto"
                                     prefWidth="150"/>

                        <TableColumn fx:id="historyBonusColumn"
                                     text="Bonusi"
                                     prefWidth="150"/>

                        <TableColumn fx:id="historyNetColumn"
                                     text="Neto"
                                     prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </content>
</ScrollPane>