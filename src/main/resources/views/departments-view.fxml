<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.company.system.controller.DepartmentsController"
            fitToWidth="true"
            pannable="true"
            hbarPolicy="AS_NEEDED"
            vbarPolicy="AS_NEEDED"
            styleClass="module-scroll">
    <content>
        <VBox spacing="18"
              styleClass="departments-page">
            <padding>
                <Insets top="28" right="28" bottom="28" left="28"/>
            </padding>

            <VBox spacing="4">
                <Label fx:id="titleLabel"
                       text="Departments"
                       styleClass="page-title"/>
                <Label fx:id="subtitleLabel"
                       text="Manage departments and their descriptions."
                       styleClass="page-subtitle"/>
            </VBox>

            <HBox spacing="12" styleClass="content-card">
                <TextField fx:id="searchField"
                           promptText="Search by name or description"
                           prefWidth="430"/>
            </HBox>

            <TableView fx:id="departmentsTable"
                       prefHeight="520"
                       minHeight="420">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="260"/>
                    <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="560"/>
                </columns>
            </TableView>

            <VBox spacing="14" styleClass="content-card">
                <Label fx:id="formTitleLabel"
                       text="Department form"
                       styleClass="section-title"/>

                <VBox spacing="10">
                    <TextField fx:id="nameField"
                               promptText="Name"
                               prefWidth="560"
                               maxWidth="560"/>

                    <TextArea fx:id="descriptionField"
                              promptText="Description"
                              prefWidth="560"
                              maxWidth="560"
                              prefHeight="120"
                              wrapText="true"/>
                </VBox>

                <HBox spacing="10">
                    <Button fx:id="addButton"
                            text="Add"
                            styleClass="success-button"
                            onAction="#addDepartment"/>
                    <Button fx:id="updateButton"
                            text="Update"
                            styleClass="primary-button"
                            onAction="#updateDepartment"/>
                    <Button fx:id="deleteButton"
                            text="Delete"
                            styleClass="danger-button"
                            onAction="#deleteDepartment"/>
                    <Button fx:id="clearButton"
                            text="Clear"
                            styleClass="secondary-button"
                            onAction="#clearForm"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
